APP_NAME=Laravel
SHOP_MODULE_ENFORCEMENT_ENABLED=false
# Delivery-scoped rider GPS; enable only after privacy and mobile QA approval.
LOGISTICS_LIVE_TRACKING_ENABLED=false
LOGISTICS_TRACKING_ROUTING_ENABLED=true
LOGISTICS_TRACKING_MAX_ACCURACY=50000
LOGISTICS_TRACKING_ROUTING_PROVIDER=osrm
LOGISTICS_TRACKING_ROUTING_BASE_URL=https://router.project-osrm.org
LOGISTICS_TRACKING_ROUTING_TIMEOUT=3
LOGISTICS_TRACKING_ROUTING_FALLBACK_DIRECT=true
LOGISTICS_TRACKING_ETA_SPEED_MPS=8.33
LOGISTICS_TRACKING_VIEWER_INTERVAL=5
LOGISTICS_TRACKING_STALE_AFTER=90
# Refresh the configuration cache after changing this flag; do not rebuild the route cache.
SHOP_OWNER_ERP_WORKSPACE_ENABLED=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@solespace.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PayMongo (frontend-only payment link)
VITE_PAYMONGO_PAYMENT_LINK=

# PayMongo (server-side)
PAYMONGO_SECRET_KEY=

# Registration location restrictions
ALLOWED_REGISTRATION_PROVINCES=["Cavite"]
